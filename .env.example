# Environment variables for ShareNest

# Server Port (Auto-assigned by Render in the cloud)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Replace <username> and <password> with your Atlas DB credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sharenest?retryWrites=true&w=majority

# JWT Secret for Authentication
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long

# Frontend URL (Only required if frontend is hosted separately on Vercel/Netlify)
# VITE_API_URL=https://sharenest.onrender.com/api
